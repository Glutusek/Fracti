OPENAI_MODEL=gemini-2.5-flash-lite

# Wygeneruj SECRET_KEY lokalnie (nie commituj wyniku):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Do ustawienia na True na prawdziwej produkcji, ze względu na zabezpieczenia Django
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Hosty i originy dla local development
# W produkcji zamienić na prawidłowe hosty
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173